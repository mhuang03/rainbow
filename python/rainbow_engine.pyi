import numpy as np
import numpy.typing as npt

NUM_ACTIONS: int
OBS_SIZE: int
ACTION_FEATURES: int
HIDDEN_SIZE: int
FULL_OBS_SIZE: int
MIN_PLAYERS: int
MAX_PLAYERS: int

class Game:
    def __init__(self, num_players: int, seed: int | None = None, leader: int = 0) -> None: ...
    @property
    def num_players(self) -> int: ...
    @property
    def current_player(self) -> int: ...
    @property
    def is_over(self) -> bool: ...
    @property
    def tricks_played(self) -> int: ...
    @property
    def trick_type(self) -> str: ...
    def legal_actions(self) -> list[int]: ...
    def legal_action_mask(self) -> npt.NDArray[np.bool_]: ...
    def is_legal(self, action: int) -> bool: ...
    def step(self, action: int) -> None: ...
    def clone(self) -> Game: ...
    def to_bytes(self) -> bytes: ...
    @staticmethod
    def from_bytes(data: bytes) -> Game: ...
    def scores(self) -> list[int]: ...
    def returns(self) -> list[float]: ...
    def winners(self) -> list[int]: ...
    def hand(self, player: int) -> list[int]: ...
    def piles(self) -> list[int]: ...
    def trick(self) -> list[tuple[int, int]]: ...
    def history(self) -> list[tuple[int, int]]: ...
    def observation(self, player: int) -> npt.NDArray[np.float32]: ...
    def full_observation(self, player: int) -> npt.NDArray[np.float32]: ...
    def determinize(self, player: int, seed: int | None = None) -> Game: ...
    def rollout(self, seed: int | None = None) -> list[float]: ...

def batch_observations(
    games: list[Game],
) -> tuple[npt.NDArray[np.float32], npt.NDArray[np.bool_]]: ...
def batch_full_observations(games: list[Game]) -> npt.NDArray[np.float32]: ...
def action_to_str(action: int) -> str: ...
def action_info(action: int) -> tuple[str, int, int]: ...

class RustAgent:
    def __init__(self, spec: str, seed: int = 0) -> None: ...
    @property
    def name(self) -> str: ...
    def act(self, game: Game) -> int: ...

def action_features() -> npt.NDArray[np.float32]: ...

class VecEnv:
    def __init__(
        self,
        num_envs: int,
        seed: int | None = None,
        players: int | None = None,
        opponents: list[str] | None = None,
        learners: int = 1,
    ) -> None: ...
    def learner_seats(self) -> npt.NDArray[np.bool_]: ...
    def __len__(self) -> int: ...
    def current_players(self) -> npt.NDArray[np.int64]: ...
    def num_players(self) -> npt.NDArray[np.int64]: ...
    def scores(self) -> npt.NDArray[np.int64]: ...
    def observe(self, full: bool = False) -> tuple[npt.NDArray[np.float32], ...]: ...
    def step(
        self, actions: npt.NDArray[np.int64]
    ) -> tuple[npt.NDArray[np.bool_], npt.NDArray[np.float32], npt.NDArray[np.int64]]: ...
    def game(self, i: int) -> Game: ...
